# ==============================================================================
# brighton-match-analysis: ai layer environment
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# IMPORTANT: Change all default passwords and tokens before production use!
# ==============================================================================

TZ=Europe/London

# Compose profiles to start. "mailpit" runs a local inbox that catches every
# email n8n sends (http://localhost:8025). Clear it once SMTP_* is a real server.
COMPOSE_PROFILES=mailpit

# Restart policy for every container: unless-stopped brings them back after a
# reboot or a Docker restart; "no" leaves them down until the next `p4n4 up`.
RESTART_POLICY=unless-stopped

# ------------------------------------------------------------------------------
# Ollama and the agent (p4n4-dashboard's Assistant tab)
# ------------------------------------------------------------------------------
# Pulled on first start (about 4.6 GB); empty pulls nothing
OLLAMA_MODEL=gemma4:e2b
OLLAMA_KEEP_ALIVE=30m
# The prompt and tools take about 2,400 tokens; Ollama's CPU default (4096)
# cuts answers off after a match summary
OLLAMA_CONTEXT_LENGTH=8192
# Whether thinking models think before answering (empty: the model's default)
AGENT_THINK=false

# ------------------------------------------------------------------------------
# The team of agents on Azure OpenAI (Microsoft Agent Framework, ai/agent/team.py)
# ------------------------------------------------------------------------------
# auto: the team answers when AZURE_OPENAI_ENDPOINT and _DEPLOYMENT are set, and
# Ollama when they aren't (or when Azure fails); local: the same team on Ollama's
# model, offline (the club's device, e.g. a Jetson); ollama: never the team
AGENT_BACKEND=auto
# The Azure OpenAI resource, e.g. https://<resource>.openai.azure.com/, and the
# deployment of a chat model with tool calling (e.g. gpt-4.1-mini)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# A key; empty: Microsoft Entra ID (the VM's managed identity on Azure, with the
# "Cognitive Services OpenAI User" role on the resource)
AZURE_OPENAI_API_KEY=
# Optional: the API version (the framework's default otherwise)
AZURE_OPENAI_API_VERSION=

# InfluxDB in ../iot (read only: the match device's health)
INFLUXDB_TOKEN=p4n4-stack-token
INFLUXDB_ORG=ming
INFLUXDB_BUCKET=raw_telemetry

# The ingest service's staff token (../iot/.env), for the agent and the reports
INGEST_READ_TOKEN=demo-read-token

# ------------------------------------------------------------------------------
# n8n (http://localhost:5678)
# ------------------------------------------------------------------------------
N8N_OWNER_EMAIL=admin@example.com
N8N_OWNER_PASSWORD=adminpassword
N8N_HOST=localhost
# 32+ characters; changing it later loses the stored credentials
N8N_ENCRYPTION_KEY=change-me-32-char-encryption-key
# true for one start: overwrite the workflows with ai/config/n8n/workflows/
N8N_REIMPORT_WORKFLOWS=false

# Must match ../iot/.env: n8n ignores posts without it
NOTIFY_TOKEN=demo-notify-token
# Which deviations reach the staff's inboxes and phones as they open: high
# (the plan's key instructions), normal, or all
NOTIFY_PRIORITY=high
# Seconds after the half-time whistle before the half-time report goes out
# (time for the analyst's last calls), and after full time for the match report
HALFTIME_DELAY=60
REPORT_DELAY=300
# The analysis room as the staff reach it, for the emails' links
ANALYSIS_URL=http://localhost:8090/analysis/
# The narrator agent's story of the half or the match in the reports: its
# language (a code or a name: en, es, pt, fr, Arabic…) and audience (coach,
# analyst, fan)
RECAP_LANGUAGE=en
RECAP_AUDIENCE=coach

EMAIL_FROM=match-analysis@example.com
# The bench and the analysts: key deviations during the match, the half-time report
STAFF_EMAIL_TO=staff@example.com
# The coaching staff: the match report after full time
REPORT_EMAIL_TO=coaches@example.com

# The SMTP server n8n sends with (Mailpit in the demo)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=

# Optional: the bench's phones. A Slack incoming webhook, and a Telegram bot and chat
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# Vision (profile "vision": the models on recorded footage, see README "Video")
# ------------------------------------------------------------------------------
# cpu, or 0 for the first NVIDIA GPU (with a CUDA build of the image)
VISION_DEVICE=cpu
