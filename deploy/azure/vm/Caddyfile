# HTTPS on the Azure VM (compose.yml): one Let's Encrypt certificate for {$SITE}, on two ports.
# Only what the judges use is reachable; everything else the stack publishes is blocked by the
# NSG (deploy/azure/main.tf).

# The browser's login (judge or admin, the app's passwords; deploy.sh hashes them from Key
# Vault). A <video> or an <img> can't send the app's token, but the browser sends this one with
# every request to the origin, so it guards the cameras too. The dashboard's nginx drops it
# before p4n4-api and Grafana; the app's token travels in X-Upstream-Authorization.
(login) {
	basic_auth {
		judge {$JUDGE_HASH}
		admin {$ADMIN_HASH}
	}
}

# The dashboard, Grafana through it (/grafana/), and the loops it plays (/cameras/)
{$SITE} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	import login

	# The loops as files (p4n4-clips), which the dashboard plays with the vision overlay
	@loops {
		method GET HEAD
		path_regexp ^/cameras/[a-z0-9-]+\.mp4$
	}
	handle @loops {
		uri strip_prefix /cameras
		request_header -Authorization
		reverse_proxy p4n4-clips:8080
	}
	handle /cameras/* {
		respond 404
	}

	handle {
		reverse_proxy p4n4-dashboard:8080 {
			# The agents' answers stream as they're written
			flush_interval -1
		}
	}
}

# The analysis room and its API (the staff token), the inbox, the cameras' streams
{$SITE}:8443 {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	redir / /analysis/
	redir /mail /mail/

	# Mailpit, at MP_WEBROOT /mail/, behind its own login (MP_UI_AUTH)
	handle /mail/* {
		reverse_proxy p4n4-mailpit:8025
	}

	# go2rtc, behind the login: the analysis room's two streams, nothing else (its API can
	# change its config)
	@cameras {
		method GET
		path /cameras/api/stream.mjpeg /cameras/api/frame.jpeg
	}
	handle @cameras {
		import login
		uri strip_prefix /cameras
		request_header -Authorization
		reverse_proxy p4n4-video:1984 {
			flush_interval -1
		}
	}
	handle /cameras/* {
		respond 404
	}

	handle {
		reverse_proxy p4n4-ingest:8080 {
			flush_interval -1
		}
	}
}
