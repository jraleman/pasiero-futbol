# ==============================================================================
# brighton-match-analysis: iot layer environment
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# IMPORTANT: Change all default passwords and tokens before production use!
# ==============================================================================

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
TZ=Europe/London

# Compose profiles to start. "demo" runs the simulator: the match engine plays
# Brighton's season (past matches on start, then a live match, sped up), and
# the device's analytics measure it. Clear this once a real device is posting.
COMPOSE_PROFILES=demo

# Restart policy for every container: unless-stopped brings them back after a
# reboot or a Docker restart; "no" leaves them down until the next `p4n4 up`
# (also: always, on-failure). Apply a change with `p4n4 up`.
RESTART_POLICY=unless-stopped

# ------------------------------------------------------------------------------
# The club
# ------------------------------------------------------------------------------
# The club's id, as its match device sends it (one device and one id for every
# match, home and away)
SITE_ID=brighton
# Site time zone: an IANA name (Europe/London) or a UTC offset (+01:00).
# "Today" and weekdays follow it, and so do timestamps sent without an offset
SITE_TZ=Europe/London
# First day of the season, for the agent's "this season"
SEASON_START=2026-08-21

# Days matches, plans and calls are kept (a season and a bit). Older ones are
# deleted every hour, and refused on arrival
RETENTION_DAYS=400

# ------------------------------------------------------------------------------
# Ingest service (the web side of the club device ↔ web contract 0.1)
# ------------------------------------------------------------------------------
# The match device's write token: it sends it as X-Site-Token. Generate one
# with `openssl rand -hex 24`. Empty: every write is refused
SITE_TOKEN=demo-site-token
# More devices, as site_id:token pairs, comma-separated (e.g. the academy's)
EXTRA_SITE_TOKENS=

# The staff's token: reading everything, saving game plans, and the analyst's
# calls. The analysis room asks for it; p4n4-api sends it for the Feed tab;
# the agent and n8n in ../ai need it too. Empty: anyone who reaches port 8090
# can read and change plans
INGEST_READ_TOKEN=demo-read-token

# Where the analysis room finds the cameras (the extras layer's go2rtc), as
# the staff's browser reaches it, e.g. http://192.168.1.20:1984. Empty: port
# 1984 on the host the page was opened from
ANALYSIS_VIDEO_URL=
# The analysis room as the staff's browsers reach it: the dashboard's Feed
# links each item there (e.g. http://192.168.1.20:8090/analysis/). Empty: no link
ANALYSIS_PUBLIC_URL=http://localhost:8090/analysis/

# First level of the MQTT topics the ingest service publishes:
# <root>/<site>/window, play/<type>, deviation, review, plan, fixture, heartbeat
MQTT_TOPIC_ROOT=brighton

# Where the ingest service posts deviations, half time and full time: n8n in
# ../ai, which tells the staff and sends the reports. Empty: nowhere.
# NOTIFY_TOKEN must match ../ai/.env
NOTIFY_URL=http://n8n:5678/webhook/brighton
NOTIFY_TOKEN=demo-notify-token
# The ai layer's agent: the analysis room's recaps (the narrator agent); empty: none
AGENT_URL=http://p4n4-ollama:11434

# The ingest service runs as this user, so ./data/ingest/ingest.db is yours.
# Set these to the output of `id -u` and `id -g`
DATA_UID=1000
DATA_GID=1000

# ------------------------------------------------------------------------------
# InfluxDB
# ------------------------------------------------------------------------------
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ORG=ming
INFLUXDB_TOKEN=p4n4-stack-token

# Bucket for everything the ingest service copies (team_window, plan_check,
# team_play, plan_deviation, deviation_review, team_fixture, the device's
# health as sensor_data and team_node), created on first start. Keep it as
# long as RETENTION_DAYS
INFLUXDB_BUCKET=raw_telemetry
INFLUXDB_RETENTION=400d

# ------------------------------------------------------------------------------
# Grafana
# ------------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=adminpassword

# Grafana's interface language for new users
GRAFANA_LANGUAGE=en-US

# true lets anyone who can reach port 3000 view dashboards without signing in
# (Viewer role: no editing). Use it for a screen in the analysis booth and
# p4n4-dashboard's normie view on a trusted network. On for the demo.
GRAFANA_ANONYMOUS=true

# true lets other sites show Grafana in a frame. p4n4-dashboard's web build
# needs it for its Grafana tab (native apps don't). On for the demo.
GRAFANA_ALLOW_EMBEDDING=true

# Path Grafana serves under. Set it to /grafana/ when p4n4-dashboard proxies
# Grafana on its own origin (its GRAFANA_UPSTREAM), e.g. for HTTPS.
GRAFANA_SUB_PATH=/

# ------------------------------------------------------------------------------
# Simulator (profile "demo")
# ------------------------------------------------------------------------------
# How much faster than real time the live match runs: 3 plays a match (with
# half time) in about 37 minutes, then a 7-minute break. 1 is real time
SIMULATOR_SPEED=3
# Past matches posted on start (Saturdays, home and away), each with its game
# plan and the analyst's calls. About 12 s of CPU each to play and measure
SIMULATOR_HISTORY=8
