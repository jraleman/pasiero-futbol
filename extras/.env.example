# ==============================================================================
# brighton-match-analysis: extras layer environment (with the match device)
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# ==============================================================================

TZ=Europe/London

# Restart policy for every container: unless-stopped brings them back after a
# reboot or a Docker restart; "no" leaves them down until the next `p4n4 up`.
RESTART_POLICY=unless-stopped

# ------------------------------------------------------------------------------
# Video (go2rtc, port 1984)
# ------------------------------------------------------------------------------
# The match cameras: rtsp://user:password@ip:554/stream, srt://…, or an http://
# MJPEG stream. H.264 is transcoded to MJPEG for the dashboard; a substream
# (640x360) keeps that cheap. Empty: clips/<camera>.mp4 on a loop if it
# exists, else a synthetic camera drawing the demo's live match (SYNTHETIC)
#
# The tactical camera: high on the main stand at halfway, the whole pitch in
# view. The one the tracker measures
CAMERA_TACTICAL_URL=
# The broadcast feed (the broadcaster's SRT/RTSP output, or a capture card)
CAMERA_TV_URL=

# The simulator's SIMULATOR_SPEED, club and time zone (iot/.env), so the
# synthetic cameras show the live match the analysis room is measuring
DEMO_SPEED=3
SITE_ID=brighton
SITE_TZ=Europe/London
